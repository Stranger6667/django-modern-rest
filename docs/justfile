# Minimal justfile for Sphinx documentation

set positional-arguments

# You can set these variables from the command line.
sphinxopts := env("SPHINXOPTS", "-W")
sourcedir  := "."
builddir   := "_build"

# Show Sphinx help
_default:
    @uv run python -msphinx -M help "{{sourcedir}}" "{{builddir}}" {{sphinxopts}}

# Catch-all: run one or more Sphinx targets. E.g., `just build clean html`
build +targets:
    #!/usr/bin/env bash
    for target in "$@"; do
        uv run python -msphinx -M "$target" "{{sourcedir}}" "{{builddir}}" {{sphinxopts}}
    done
