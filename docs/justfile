# Minimal justfile for Sphinx documentation

# You can set these variables from the command line.
sphinxopts := env("SPHINXOPTS", "-W")
sourcedir  := "."
builddir   := "_build"

[private]
sphinx target *opts:
    @uv run python -msphinx -M "{{target}}" "{{sourcedir}}" "{{builddir}}" {{sphinxopts}} {{opts}}

# Show Sphinx help (default)
_default: (sphinx "help")

# Build HTML documentation
html *opts: (sphinx "html" opts)

# Remove build output
clean *opts: (sphinx "clean" opts)

# Pass-through: route any target to Sphinx
build target *opts: (sphinx target opts)
